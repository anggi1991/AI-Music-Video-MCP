# Local Python environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local web build and dependencies
web-ui/node_modules/
web-ui/.next/
web-ui/tsconfig.tsbuildinfo

# Workspace audio, video, exports, model weights, and user project data
workspace/*
!workspace/source_songs/
workspace/source_songs/*
!workspace/source_songs/.gitkeep

!workspace/input_stems/
workspace/input_stems/*
!workspace/input_stems/.gitkeep

!workspace/output_audio/
workspace/output_audio/*
!workspace/output_audio/.gitkeep

!workspace/output_tabs/
workspace/output_tabs/*
!workspace/output_tabs/.gitkeep

!workspace/veo_footage/
workspace/veo_footage/*
!workspace/veo_footage/.gitkeep

# Pretrained model weights
*.ckpt
*.th
*.onnx

# Local credentials, machine paths, and developer settings
.env
.env.*
!.env.example
mcp_config.json
.claude/settings.local.json
